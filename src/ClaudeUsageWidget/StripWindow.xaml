<Window x:Class="ClaudeUsageWidget.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeUsageWidget"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Background="#01000000"
        FontFamily="Segoe UI" FontSize="12">
    <Window.ContextMenu>
        <ContextMenu x:Name="Menu">
            <MenuItem Header="Details" Click="OnDetails"/>
            <MenuItem Header="Refresh now" Click="OnRefresh"/>
            <Separator/>
            <MenuItem x:Name="AutostartItem" Header="Start with Windows" IsCheckable="True" Click="OnAutostart"/>
            <MenuItem Header="Reset position" Click="OnResetPosition"/>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExit"/>
        </ContextMenu>
    </Window.ContextMenu>
    <Border Padding="8,0,8,0" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Line1" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
            <TextBlock x:Name="Line2" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
        </StackPanel>
    </Border>
</Window>
