<Window x:Class="ClaudeUsageWidget.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude usage"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Width="340" SizeToContent="Height"
        Background="Transparent"
        FontFamily="Segoe UI" FontSize="13">
    <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" Padding="16,14,16,12">
        <Grid>
            <StackPanel x:Name="Body"/>
            <Button x:Name="CloseButton" ToolTip="Close (Esc)" Width="24" Height="24" Margin="0,-10,-10,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
